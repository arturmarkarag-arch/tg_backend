    "axios": "^1.7.2",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.7.0",
    "multer": "^2.1.1",
    "node-telegram-bot-api": "^0.67.0",
    "openai": "^4.8.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
